{
  "name": "cf-compass",
  "version": "3.11.5",
  "packageManager": "pnpm@11.19.0",
  "private": true,
  "author": "CF Compass",
  "license": "MIT",
  "description": "A local-first training, review, and contest analysis companion for OI, ICPC, Codeforces, and competitive programmers.",
  "homepage": "https://github.com/qeffg/cf-compass#readme",
  "bugs": {
    "url": "https://github.com/qeffg/cf-compass/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qeffg/cf-compass.git"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "postinstall": "install-electron --no",
    "dev": "vite --host 127.0.0.1",
    "desktop": "concurrently -k \"pnpm dev\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "verify": "vite build",
    "desktop:pack": "vite build && electron-builder --dir",
    "desktop:build": "vite build && electron-builder --win portable"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.cfcompass.desktop",
    "productName": "CF Compass",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "signExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CF-Compass-${version}-portable.${ext}"
    }
  }
}
